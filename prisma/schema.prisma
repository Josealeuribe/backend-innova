generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider     = "mysql"
  relationMode = "foreignKeys"
}

enum EstadoRegistro {
  ACTIVO
  INACTIVO
}

enum EstadoInventario {
  DISPONIBLE
  EN_USO
  EN_MANTENIMIENTO
  DANADO
  DADO_DE_BAJA
}

// ======================================================
// UBICACIONES
// ======================================================

model Pais {
  idPais Int    @id @default(autoincrement()) @map("id_pais") @db.UnsignedInt
  nombre String @unique(map: "uq_paises_nombre") @db.VarChar(100)

  departamentos   Departamento[]
  razonesSociales RazonSocial[]
  maquinas        Maquina[]

  @@map("paises")
}

model Departamento {
  idDepartamento Int    @id @default(autoincrement()) @map("id_departamentos") @db.UnsignedInt
  nombre         String @db.VarChar(120)
  idPais         Int    @map("id_pais") @db.UnsignedInt

  pais            Pais          @relation(fields: [idPais], references: [idPais], onDelete: Restrict, onUpdate: Cascade, map: "fk_departamentos_paises")
  ciudades        Ciudad[]
  razonesSociales RazonSocial[]

  @@unique([idPais, nombre], map: "uq_departamentos_pais_nombre")
  @@index([idPais], map: "idx_departamentos_pais")
  @@index([nombre], map: "idx_departamentos_nombre")
  @@map("departamentos")
}

model Ciudad {
  idCiudad       Int            @id @default(autoincrement()) @map("id_ciudad") @db.UnsignedInt
  nombreCiudad   String         @map("nombre_ciudad") @db.VarChar(150)
  idDepartamento Int            @map("id_departamentos") @db.UnsignedInt
  estado         EstadoRegistro @default(ACTIVO)

  departamento    Departamento  @relation(fields: [idDepartamento], references: [idDepartamento], onDelete: Restrict, onUpdate: Cascade, map: "fk_ciudades_departamentos")
  usuarios        Usuario[]
  casinos         Casino[]
  razonesSociales RazonSocial[]

  fechaCreacion      DateTime @default(now()) @map("fecha_creacion") @db.DateTime(0)
  fechaActualizacion DateTime @default(now()) @updatedAt @map("fecha_actualizacion") @db.DateTime(0)

  @@unique([idDepartamento, nombreCiudad], map: "uq_ciudades_departamento_nombre")
  @@index([idDepartamento], map: "idx_ciudades_departamento")
  @@index([nombreCiudad], map: "idx_ciudades_nombre")
  @@index([estado], map: "idx_ciudades_estado")
  @@map("ciudades")
}

// ======================================================
// CATÁLOGOS DE USUARIOS
// ======================================================

model Rol {
  idRol       Int            @id @default(autoincrement()) @map("id_rol") @db.UnsignedInt
  nombreRol   String         @unique(map: "uq_roles_nombre") @map("nombre_rol") @db.VarChar(100)
  descripcion String?        @db.VarChar(255)
  estado      EstadoRegistro @default(ACTIVO)

  usuarios Usuario[]
  permisos RolPermiso[]

  fechaCreacion      DateTime @default(now()) @map("fecha_creacion") @db.DateTime(0)
  fechaActualizacion DateTime @default(now()) @updatedAt @map("fecha_actualizacion") @db.DateTime(0)

  @@index([estado], map: "idx_roles_estado")
  @@map("roles")
}

model TipoDocumento {
  idTipoDoc Int            @id @default(autoincrement()) @map("id_tipo_doc") @db.UnsignedInt
  nombreDoc String         @unique(map: "uq_tipos_documento_nombre") @map("nombre_doc") @db.VarChar(50)
  estado    EstadoRegistro @default(ACTIVO)

  usuarios Usuario[]

  fechaCreacion      DateTime @default(now()) @map("fecha_creacion") @db.DateTime(0)
  fechaActualizacion DateTime @default(now()) @updatedAt @map("fecha_actualizacion") @db.DateTime(0)

  @@index([estado], map: "idx_tipos_documento_estado")
  @@map("tipos_documento")
}

model Genero {
  idGenero     Int            @id @default(autoincrement()) @map("id_genero") @db.UnsignedInt
  nombreGenero String         @unique(map: "uq_generos_nombre") @map("nombre_genero") @db.VarChar(50)
  estado       EstadoRegistro @default(ACTIVO)

  usuarios Usuario[]

  fechaCreacion      DateTime @default(now()) @map("fecha_creacion") @db.DateTime(0)
  fechaActualizacion DateTime @default(now()) @updatedAt @map("fecha_actualizacion") @db.DateTime(0)

  @@index([estado], map: "idx_generos_estado")
  @@map("generos")
}

// ======================================================
// MÓDULOS, ACCIONES Y PERMISOS
// ======================================================

model Modulo {
  idModulo      Int            @id @default(autoincrement()) @map("id_modulo") @db.UnsignedInt
  codigo        String         @unique(map: "uq_modulos_codigo") @db.VarChar(50)
  nombre        String         @db.VarChar(100)
  descripcion   String?        @db.VarChar(255)
  ruta          String?        @db.VarChar(200)
  icono         String?        @db.VarChar(100)
  orden         Int            @default(0) @db.UnsignedInt
  visibleMenu   Boolean        @default(true) @map("visible_menu")
  idModuloPadre Int?           @map("id_modulo_padre") @db.UnsignedInt
  estado        EstadoRegistro @default(ACTIVO)

  moduloPadre Modulo?   @relation("JerarquiaModulos", fields: [idModuloPadre], references: [idModulo], onDelete: Restrict, onUpdate: Cascade, map: "fk_modulos_modulo_padre")
  submodulos  Modulo[]  @relation("JerarquiaModulos")
  permisos    Permiso[]

  fechaCreacion      DateTime @default(now()) @map("fecha_creacion") @db.DateTime(0)
  fechaActualizacion DateTime @default(now()) @updatedAt @map("fecha_actualizacion") @db.DateTime(0)

  @@index([estado], map: "idx_modulos_estado")
  @@index([orden], map: "idx_modulos_orden")
  @@index([idModuloPadre], map: "idx_modulos_padre")
  @@index([visibleMenu], map: "idx_modulos_visible_menu")
  @@index([nombre], map: "idx_modulos_nombre")
  @@map("modulos")
}

model Accion {
  idAccion    Int            @id @default(autoincrement()) @map("id_accion") @db.UnsignedInt
  codigo      String         @unique(map: "uq_acciones_codigo") @db.VarChar(30)
  nombre      String         @db.VarChar(80)
  descripcion String?        @db.VarChar(255)
  estado      EstadoRegistro @default(ACTIVO)

  permisos Permiso[]

  fechaCreacion      DateTime @default(now()) @map("fecha_creacion") @db.DateTime(0)
  fechaActualizacion DateTime @default(now()) @updatedAt @map("fecha_actualizacion") @db.DateTime(0)

  @@index([estado], map: "idx_acciones_estado")
  @@index([nombre], map: "idx_acciones_nombre")
  @@map("acciones")
}

model Permiso {
  idPermiso Int            @id @default(autoincrement()) @map("id_permiso") @db.UnsignedInt
  idModulo  Int            @map("id_modulo") @db.UnsignedInt
  idAccion  Int            @map("id_accion") @db.UnsignedInt
  estado    EstadoRegistro @default(ACTIVO)

  modulo Modulo       @relation(fields: [idModulo], references: [idModulo], onDelete: Restrict, onUpdate: Cascade, map: "fk_permisos_modulos")
  accion Accion       @relation(fields: [idAccion], references: [idAccion], onDelete: Restrict, onUpdate: Cascade, map: "fk_permisos_acciones")
  roles  RolPermiso[]

  fechaCreacion      DateTime @default(now()) @map("fecha_creacion") @db.DateTime(0)
  fechaActualizacion DateTime @default(now()) @updatedAt @map("fecha_actualizacion") @db.DateTime(0)

  @@unique([idModulo, idAccion], map: "uq_permisos_modulo_accion")
  @@index([idModulo], map: "idx_permisos_modulo")
  @@index([idAccion], map: "idx_permisos_accion")
  @@index([estado], map: "idx_permisos_estado")
  @@map("permisos")
}

model RolPermiso {
  idRol     Int     @map("id_rol") @db.UnsignedInt
  idPermiso Int     @map("id_permiso") @db.UnsignedInt
  permitido Boolean @default(true)

  rol     Rol     @relation(fields: [idRol], references: [idRol], onDelete: Cascade, onUpdate: Cascade, map: "fk_roles_permisos_roles")
  permiso Permiso @relation(fields: [idPermiso], references: [idPermiso], onDelete: Cascade, onUpdate: Cascade, map: "fk_roles_permisos_permisos")

  fechaCreacion      DateTime @default(now()) @map("fecha_creacion") @db.DateTime(0)
  fechaActualizacion DateTime @default(now()) @updatedAt @map("fecha_actualizacion") @db.DateTime(0)

  @@id([idRol, idPermiso])
  @@index([idPermiso], map: "idx_roles_permisos_permiso")
  @@index([permitido], map: "idx_roles_permisos_permitido")
  @@map("roles_permisos")
}

// ======================================================
// CENTROS DE COSTOS
// ======================================================

model CentroCosto {
  idCentroCosto     Int            @id @default(autoincrement()) @map("id_centro_costo") @db.UnsignedInt
  codigoCentroCosto String         @unique(map: "uq_centros_costos_codigo") @map("codigo_centro_costo") @db.VarChar(50)
  nombreCentroCosto String         @map("nombre_centro_costo") @db.VarChar(150)
  estado            EstadoRegistro @default(ACTIVO)

  casinos Casino[]

  fechaCreacion      DateTime @default(now()) @map("fecha_creacion") @db.DateTime(0)
  fechaActualizacion DateTime @default(now()) @updatedAt @map("fecha_actualizacion") @db.DateTime(0)

  @@index([estado], map: "idx_centros_costos_estado")
  @@index([nombreCentroCosto], map: "idx_centros_costos_nombre")
  @@map("centros_costos")
}

// ======================================================
// CATÁLOGOS TRIBUTARIOS / DIAN
// ======================================================

model TipoPersona {
  idTipoPersona Int            @id @default(autoincrement()) @map("id_tipo_persona") @db.UnsignedInt
  codigo        String         @unique(map: "uq_tipos_persona_codigo") @db.VarChar(30)
  nombre        String         @unique(map: "uq_tipos_persona_nombre") @db.VarChar(100)
  estado        EstadoRegistro @default(ACTIVO)

  razonesSociales RazonSocial[]

  fechaCreacion      DateTime @default(now()) @map("fecha_creacion") @db.DateTime(0)
  fechaActualizacion DateTime @default(now()) @updatedAt @map("fecha_actualizacion") @db.DateTime(0)

  @@index([estado], map: "idx_tipos_persona_estado")
  @@index([nombre], map: "idx_tipos_persona_nombre")
  @@map("tipos_persona")
}

model AmbienteDian {
  idAmbienteDian Int            @id @default(autoincrement()) @map("id_ambiente_dian") @db.UnsignedInt
  codigo         String         @unique(map: "uq_ambientes_dian_codigo") @db.VarChar(30)
  nombre         String         @unique(map: "uq_ambientes_dian_nombre") @db.VarChar(100)
  estado         EstadoRegistro @default(ACTIVO)

  razonesSociales RazonSocial[]

  fechaCreacion      DateTime @default(now()) @map("fecha_creacion") @db.DateTime(0)
  fechaActualizacion DateTime @default(now()) @updatedAt @map("fecha_actualizacion") @db.DateTime(0)

  @@index([estado], map: "idx_ambientes_dian_estado")
  @@index([nombre], map: "idx_ambientes_dian_nombre")
  @@map("ambientes_dian")
}

model Regimen {
  idRegimen Int            @id @default(autoincrement()) @map("id_regimen") @db.UnsignedInt
  codigo    String         @unique(map: "uq_regimenes_codigo") @db.VarChar(30)
  nombre    String         @unique(map: "uq_regimenes_nombre") @db.VarChar(120)
  estado    EstadoRegistro @default(ACTIVO)

  razonesSociales RazonSocial[]

  fechaCreacion      DateTime @default(now()) @map("fecha_creacion") @db.DateTime(0)
  fechaActualizacion DateTime @default(now()) @updatedAt @map("fecha_actualizacion") @db.DateTime(0)

  @@index([estado], map: "idx_regimenes_estado")
  @@index([nombre], map: "idx_regimenes_nombre")
  @@map("regimenes")
}

// ======================================================
// RAZONES SOCIALES
// ======================================================

model RazonSocial {
  idRazonSocial     Int    @id @default(autoincrement()) @map("id_razon_social") @db.UnsignedInt
  nit               String @unique(map: "uq_razones_sociales_nit") @db.VarChar(30)
  nombreRazonSocial String @map("nombre_razon_social") @db.VarChar(180)

  telefono     String  @db.VarChar(30)
  direccion    String  @db.VarChar(200)
  codigoPostal String? @map("codigo_postal") @db.VarChar(20)
  correo       String  @unique(map: "uq_razones_sociales_correo") @db.VarChar(191)

  idPais         Int @map("id_pais") @db.UnsignedInt
  idDepartamento Int @map("id_departamentos") @db.UnsignedInt
  idCiudad       Int @map("id_ciudad") @db.UnsignedInt

  pais         Pais         @relation(fields: [idPais], references: [idPais], onDelete: Restrict, onUpdate: Cascade, map: "fk_razones_sociales_paises")
  departamento Departamento @relation(fields: [idDepartamento], references: [idDepartamento], onDelete: Restrict, onUpdate: Cascade, map: "fk_razones_sociales_departamentos")
  ciudad       Ciudad       @relation(fields: [idCiudad], references: [idCiudad], onDelete: Restrict, onUpdate: Cascade, map: "fk_razones_sociales_ciudades")

  idTipoPersona  Int @map("id_tipo_persona") @db.UnsignedInt
  idAmbienteDian Int @map("id_ambiente_dian") @db.UnsignedInt
  idRegimen      Int @map("id_regimen") @db.UnsignedInt

  tipoPersona  TipoPersona  @relation(fields: [idTipoPersona], references: [idTipoPersona], onDelete: Restrict, onUpdate: Cascade, map: "fk_razones_sociales_tipos_persona")
  ambienteDian AmbienteDian @relation(fields: [idAmbienteDian], references: [idAmbienteDian], onDelete: Restrict, onUpdate: Cascade, map: "fk_razones_sociales_ambientes_dian")
  regimen      Regimen      @relation(fields: [idRegimen], references: [idRegimen], onDelete: Restrict, onUpdate: Cascade, map: "fk_razones_sociales_regimenes")

  responsabilidadFiscal String @map("responsabilidad_fiscal") @db.VarChar(120)

  contratoColjuegos   String?   @map("contrato_coljuegos") @db.VarChar(100)
  fechaInicioContrato DateTime? @map("fecha_inicio_contrato") @db.Date
  fechaFinContrato    DateTime? @map("fecha_fin_contrato") @db.Date

  softwareId   String? @map("software_id") @db.VarChar(100)
  softwarePin  String? @map("software_pin") @db.VarChar(255)
  testSetId    String? @map("test_set_id") @db.VarChar(150)
  claveTecnica String? @map("clave_tecnica") @db.VarChar(255)

  numeroResolucion      String?   @map("numero_resolucion") @db.VarChar(100)
  prefijoResolucion     String?   @map("prefijo_resolucion") @db.VarChar(30)
  rangoInicio           String?   @map("rango_inicio") @db.VarChar(30)
  rangoFin              String?   @map("rango_fin") @db.VarChar(30)
  fechaInicioResolucion DateTime? @map("fecha_inicio_resolucion") @db.Date
  fechaFinResolucion    DateTime? @map("fecha_fin_resolucion") @db.Date

  codigoHelisa String?        @map("codigo_helisa") @db.VarChar(50)
  estado       EstadoRegistro @default(ACTIVO)

  casinos Casino[]

  resolucionesDian     ResolucionDian[]
  facturasElectronicas FacturaElectronica[]
  documentosSoporte    DocumentoSoporte[]
  documentosRecibidos  DocumentoRecibido[]
  reglasMapeoPuc       ReglaMapeoPUC[]

  fechaCreacion      DateTime @default(now()) @map("fecha_creacion") @db.DateTime(0)
  fechaActualizacion DateTime @default(now()) @updatedAt @map("fecha_actualizacion") @db.DateTime(0)

  @@index([estado], map: "idx_razones_sociales_estado")
  @@index([nombreRazonSocial], map: "idx_razones_sociales_nombre")
  @@index([idPais], map: "idx_razones_sociales_pais")
  @@index([idDepartamento], map: "idx_razones_sociales_departamento")
  @@index([idCiudad], map: "idx_razones_sociales_ciudad")
  @@index([idTipoPersona], map: "idx_razones_sociales_tipo_persona")
  @@index([idAmbienteDian], map: "idx_razones_sociales_ambiente_dian")
  @@index([idRegimen], map: "idx_razones_sociales_regimen")
  @@index([codigoHelisa], map: "idx_razones_sociales_codigo_helisa")
  @@map("razones_sociales")
}

// ======================================================
// CASINOS
// ======================================================

model Casino {
  idCasino Int @id @default(autoincrement()) @map("id_casino") @db.UnsignedInt

  nombreCasino          String @unique(map: "uq_casinos_nombre") @map("nombre_casino") @db.VarChar(150)
  codigoDane            String @unique(map: "uq_casinos_codigo_dane") @map("codigo_dane") @db.VarChar(30)
  codigoEstablecimiento String @unique(map: "uq_casinos_codigo_establecimiento") @map("codigo_establecimiento") @db.VarChar(50)

  telefono  String         @db.VarChar(30)
  direccion String         @db.VarChar(200)
  estado    EstadoRegistro @default(ACTIVO)

  idCiudad      Int @map("id_ciudad") @db.UnsignedInt
  idCentroCosto Int @map("id_centro_costo") @db.UnsignedInt
  idRazonSocial Int @map("id_razon_social") @db.UnsignedInt

  ciudad      Ciudad      @relation(fields: [idCiudad], references: [idCiudad], onDelete: Restrict, onUpdate: Cascade, map: "fk_casinos_ciudades")
  centroCosto CentroCosto @relation(fields: [idCentroCosto], references: [idCentroCosto], onDelete: Restrict, onUpdate: Cascade, map: "fk_casinos_centros_costos")
  razonSocial RazonSocial @relation(fields: [idRazonSocial], references: [idRazonSocial], onDelete: Restrict, onUpdate: Cascade, map: "fk_casinos_razones_sociales")

  usuarios            Usuario[]
  inventarios         Inventario[]
  maquinas            Maquina[]
  documentosRecibidos DocumentoRecibido[]

  fechaCreacion      DateTime @default(now()) @map("fecha_creacion") @db.DateTime(0)
  fechaActualizacion DateTime @default(now()) @updatedAt @map("fecha_actualizacion") @db.DateTime(0)

  @@index([estado], map: "idx_casinos_estado")
  @@index([idCiudad], map: "idx_casinos_ciudad")
  @@index([idCentroCosto], map: "idx_casinos_centro_costo")
  @@index([idRazonSocial], map: "idx_casinos_razon_social")
  @@index([nombreCasino], map: "idx_casinos_nombre")
  @@map("casinos")
}

// ======================================================
// INVENTARIO
// ======================================================

model Inventario {
  idInventario Int @id @default(autoincrement()) @map("id_inventario") @db.UnsignedInt

  fotoSerial String? @map("foto_serial") @db.VarChar(500)
  fotoEstado String? @map("foto_estado") @db.VarChar(500)

  codigo        String  @unique(map: "uq_inventarios_codigo") @db.VarChar(50)
  nombre        String  @db.VarChar(150)
  serial        String? @unique(map: "uq_inventarios_serial") @db.VarChar(100)
  clasificacion String  @db.VarChar(100)

  estado         EstadoInventario @default(DISPONIBLE)
  estadoRegistro EstadoRegistro   @default(ACTIVO) @map("estado_registro")

  cantidad Int     @default(1) @db.UnsignedInt
  valor    Decimal @default(0.00) @db.Decimal(15, 2)

  idCasino      Int  @map("id_casino") @db.UnsignedInt
  idResponsable Int? @map("id_responsable") @db.UnsignedInt

  ubicacionLocal   String?   @map("ubicacion_local") @db.VarChar(200)
  fechaAdquisicion DateTime? @map("fecha_adquisicion") @db.Date
  observaciones    String?   @db.Text

  casino      Casino   @relation(fields: [idCasino], references: [idCasino], onDelete: Restrict, onUpdate: Cascade, map: "fk_inventarios_casinos")
  responsable Usuario? @relation("InventarioResponsable", fields: [idResponsable], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_inventarios_responsables")
  maquina     Maquina?

  fechaCreacion      DateTime @default(now()) @map("fecha_creacion") @db.DateTime(0)
  fechaActualizacion DateTime @default(now()) @updatedAt @map("fecha_actualizacion") @db.DateTime(0)

  @@index([nombre], map: "idx_inventarios_nombre")
  @@index([serial], map: "idx_inventarios_serial")
  @@index([clasificacion], map: "idx_inventarios_clasificacion")
  @@index([estado], map: "idx_inventarios_estado")
  @@index([estadoRegistro], map: "idx_inventarios_estado_registro")
  @@index([idCasino], map: "idx_inventarios_casino")
  @@index([idResponsable], map: "idx_inventarios_responsable")
  @@index([fechaAdquisicion], map: "idx_inventarios_fecha_adquisicion")
  @@map("inventarios")
}

// ======================================================
// TIPOS DE MÁQUINA
// ======================================================

model TipoMaquina {
  idTipoMaquina Int            @id @default(autoincrement()) @map("id_tipo_maquina") @db.UnsignedInt
  codigo        String         @unique(map: "uq_tipos_maquina_codigo") @db.VarChar(50)
  nombre        String         @unique(map: "uq_tipos_maquina_nombre") @db.VarChar(120)
  descripcion   String?        @db.VarChar(255)
  estado        EstadoRegistro @default(ACTIVO)

  maquinas Maquina[]

  fechaCreacion      DateTime @default(now()) @map("fecha_creacion") @db.DateTime(0)
  fechaActualizacion DateTime @default(now()) @updatedAt @map("fecha_actualizacion") @db.DateTime(0)

  @@index([estado], map: "idx_tipos_maquina_estado")
  @@index([nombre], map: "idx_tipos_maquina_nombre")
  @@map("tipos_maquina")
}

// ======================================================
// MÁQUINAS
// ======================================================

model Maquina {
  idMaquina Int @id @default(autoincrement()) @map("id_maquina") @db.UnsignedInt

  idInventario  Int @unique(map: "uq_maquinas_inventario") @map("id_inventario") @db.UnsignedInt
  idCasino      Int @map("id_casino") @db.UnsignedInt
  idPais        Int @map("id_pais") @db.UnsignedInt
  idTipoMaquina Int @map("id_tipo_maquina") @db.UnsignedInt

  serial        String @unique(map: "uq_maquinas_serial") @db.VarChar(100)
  numeroInterno String @unique(map: "uq_maquinas_numero_interno") @map("numero_interno") @db.VarChar(50)
  nuc           String @unique(map: "uq_maquinas_nuc") @db.VarChar(100)
  nuid          String @unique(map: "uq_maquinas_nuid") @db.VarChar(100)
  marca         String @db.VarChar(100)
  modelo        String @db.VarChar(100)

  fechaFabricacion        DateTime  @map("fecha_fabricacion") @db.Date
  frecuenciaMantenimiento Int       @map("frecuencia_mantenimiento") @db.UnsignedInt
  ultimoMantenimiento     DateTime? @map("ultimo_mantenimiento") @db.Date
  imgDocumentoLegal       String?   @map("img_documento_legal") @db.VarChar(500)

  estado EstadoRegistro @default(ACTIVO)

  inventario  Inventario  @relation(fields: [idInventario], references: [idInventario], onDelete: Restrict, onUpdate: Cascade, map: "fk_maquinas_inventarios")
  casino      Casino      @relation(fields: [idCasino], references: [idCasino], onDelete: Restrict, onUpdate: Cascade, map: "fk_maquinas_casinos")
  pais        Pais        @relation(fields: [idPais], references: [idPais], onDelete: Restrict, onUpdate: Cascade, map: "fk_maquinas_paises")
  tipoMaquina TipoMaquina @relation(fields: [idTipoMaquina], references: [idTipoMaquina], onDelete: Restrict, onUpdate: Cascade, map: "fk_maquinas_tipos_maquina")

  fechaCreacion      DateTime @default(now()) @map("fecha_creacion") @db.DateTime(0)
  fechaActualizacion DateTime @default(now()) @updatedAt @map("fecha_actualizacion") @db.DateTime(0)

  @@index([estado], map: "idx_maquinas_estado")
  @@index([idCasino], map: "idx_maquinas_casino")
  @@index([idPais], map: "idx_maquinas_pais")
  @@index([idTipoMaquina], map: "idx_maquinas_tipo")
  @@index([marca], map: "idx_maquinas_marca")
  @@index([modelo], map: "idx_maquinas_modelo")
  @@index([fechaFabricacion], map: "idx_maquinas_fecha_fabricacion")
  @@index([ultimoMantenimiento], map: "idx_maquinas_ultimo_mantenimiento")
  @@map("maquinas")
}

// ======================================================
// USUARIOS
// ======================================================

model Usuario {
  id           Int    @id @default(autoincrement()) @db.UnsignedInt
  nombre       String @db.VarChar(100)
  apellido     String @db.VarChar(100)
  cedula       String @unique(map: "uq_usuarios_cedula") @db.VarChar(30)
  correo       String @unique(map: "uq_usuarios_correo") @db.VarChar(191)
  passwordHash String @map("password_hash") @db.VarChar(255)

  cargo           String   @db.VarChar(120)
  fechaNacimiento DateTime @map("fecha_nacimiento") @db.Date
  telefono        String   @db.VarChar(30)

  codigoHelisa String?        @map("codigo_helisa") @db.VarChar(50)
  cuentaPuc    String?        @map("cuenta_puc") @db.VarChar(50)
  imgUrl       String?        @map("img_url") @db.VarChar(500)
  estado       EstadoRegistro @default(ACTIVO)

  idTipoDoc Int @map("id_tipo_doc") @db.UnsignedInt
  idGenero  Int @map("id_genero") @db.UnsignedInt
  idRol     Int @map("id_rol") @db.UnsignedInt
  idCiudad  Int @map("id_ciudad") @db.UnsignedInt
  idCasino  Int @map("id_casino") @db.UnsignedInt

  tipoDocumento TipoDocumento @relation(fields: [idTipoDoc], references: [idTipoDoc], onDelete: Restrict, onUpdate: Cascade, map: "fk_usuarios_tipos_documento")
  genero        Genero        @relation(fields: [idGenero], references: [idGenero], onDelete: Restrict, onUpdate: Cascade, map: "fk_usuarios_generos")
  rol           Rol           @relation(fields: [idRol], references: [idRol], onDelete: Restrict, onUpdate: Cascade, map: "fk_usuarios_roles")
  ciudad        Ciudad        @relation(fields: [idCiudad], references: [idCiudad], onDelete: Restrict, onUpdate: Cascade, map: "fk_usuarios_ciudades")
  casino        Casino        @relation(fields: [idCasino], references: [idCasino], onDelete: Restrict, onUpdate: Cascade, map: "fk_usuarios_casinos")

  inventariosResponsable      Inventario[]         @relation("InventarioResponsable")
  facturasElectronicasCreadas FacturaElectronica[]

  fechaCreacion      DateTime @default(now()) @map("fecha_creacion") @db.DateTime(0)
  fechaActualizacion DateTime @default(now()) @updatedAt @map("fecha_actualizacion") @db.DateTime(0)

  @@index([estado], map: "idx_usuarios_estado")
  @@index([idTipoDoc], map: "idx_usuarios_tipo_documento")
  @@index([idGenero], map: "idx_usuarios_genero")
  @@index([idRol], map: "idx_usuarios_rol")
  @@index([idCiudad], map: "idx_usuarios_ciudad")
  @@index([idCasino], map: "idx_usuarios_casino")
  @@index([apellido, nombre], map: "idx_usuarios_apellido_nombre")
  @@index([codigoHelisa], map: "idx_usuarios_codigo_helisa")
  @@map("usuarios")
}

// ======================================================
// FACTURACIÓN ELECTRÓNICA DIAN — EMISIÓN (FASE 1)
// Fundación: resoluciones, clientes, factura de venta (CUFE + XML,
// sin firma ni envío SOAP). DocumentoSoporte/NotaCredito/NotaDebito
// se modelan aquí pero su lógica de negocio queda para fases futuras.
// ======================================================

enum TipoDocumentoDian {
  FACTURA
  DOC_SOPORTE
}

enum EstadoDocumentoDian {
  PENDIENTE
  ENVIANDO
  EN_PROCESO
  ACEPTADO
  RECHAZADO
  ERROR_TECNICO
}

enum TipoEventoDian {
  CREADO
  XML_GENERADO
  FIRMADO
  ENVIADO
  TRACK_ID_RECIBIDO
  EN_PROCESO
  ACEPTADO
  RECHAZADO
  ERROR_TECNICO
  RETRY_SCHEDULED
}

model ResolucionDian {
  idResolucionDian Int @id @default(autoincrement()) @map("id_resolucion_dian") @db.UnsignedInt

  idRazonSocial Int         @map("id_razon_social") @db.UnsignedInt
  razonSocial   RazonSocial @relation(fields: [idRazonSocial], references: [idRazonSocial], onDelete: Restrict, onUpdate: Cascade, map: "fk_resoluciones_dian_razones_sociales")

  tipoDocumento TipoDocumentoDian @map("tipo_documento")
  entorno       String            @db.VarChar(1) // '1' Producción, '2' Habilitación (valores DIAN)

  prefijo           String @db.VarChar(10)
  numeroResolucion  String @map("numero_resolucion") @db.VarChar(100)
  rangoDesde        Int    @map("rango_desde") @db.UnsignedInt
  rangoHasta        Int    @map("rango_hasta") @db.UnsignedInt
  consecutivoActual Int    @default(0) @map("consecutivo_actual") @db.UnsignedInt

  fechaVigenciaDesde DateTime @map("fecha_vigencia_desde") @db.Date
  fechaVigenciaHasta DateTime @map("fecha_vigencia_hasta") @db.Date
  claveTecnica       String   @map("clave_tecnica") @db.VarChar(255)

  activa Boolean @default(true)

  facturasElectronicas FacturaElectronica[]

  fechaCreacion      DateTime @default(now()) @map("fecha_creacion") @db.DateTime(0)
  fechaActualizacion DateTime @default(now()) @updatedAt @map("fecha_actualizacion") @db.DateTime(0)

  @@index([idRazonSocial], map: "idx_resoluciones_dian_razon_social")
  @@index([tipoDocumento, entorno, activa], map: "idx_resoluciones_dian_tipo_entorno_activa")
  @@map("dian_resoluciones")
}

model ClienteDian {
  idClienteDian Int @id @default(autoincrement()) @map("id_cliente_dian") @db.UnsignedInt

  nombre                String  @db.VarChar(180)
  tipoDocumento         String  @default("13") @map("tipo_documento") @db.VarChar(5)
  numeroDocumento       String  @unique(map: "uq_clientes_dian_numero_documento") @map("numero_documento") @db.VarChar(30)
  direccion             String? @db.VarChar(200)
  ciudad                String? @db.VarChar(150)
  departamento          String? @db.VarChar(150)
  telefono              String? @db.VarChar(30)
  email                 String? @db.VarChar(191)
  tipoPersona           String  @default("2") @map("tipo_persona") @db.VarChar(5)
  responsabilidadFiscal String  @default("R-99-PN") @map("responsabilidad_fiscal") @db.VarChar(50)

  facturasElectronicas FacturaElectronica[]

  fechaCreacion      DateTime @default(now()) @map("fecha_creacion") @db.DateTime(0)
  fechaActualizacion DateTime @default(now()) @updatedAt @map("fecha_actualizacion") @db.DateTime(0)

  @@index([nombre], map: "idx_clientes_dian_nombre")
  @@map("clientes_dian")
}

model FacturaElectronica {
  idFacturaElectronica Int @id @default(autoincrement()) @map("id_factura_electronica") @db.UnsignedInt

  idRazonSocial    Int @map("id_razon_social") @db.UnsignedInt
  idClienteDian    Int @map("id_cliente_dian") @db.UnsignedInt
  idUsuario        Int @map("id_usuario") @db.UnsignedInt
  idResolucionDian Int @map("id_resolucion_dian") @db.UnsignedInt

  razonSocial    RazonSocial    @relation(fields: [idRazonSocial], references: [idRazonSocial], onDelete: Restrict, onUpdate: Cascade, map: "fk_facturas_electronicas_razones_sociales")
  clienteDian    ClienteDian    @relation(fields: [idClienteDian], references: [idClienteDian], onDelete: Restrict, onUpdate: Cascade, map: "fk_facturas_electronicas_clientes_dian")
  usuario        Usuario        @relation(fields: [idUsuario], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_facturas_electronicas_usuarios")
  resolucionDian ResolucionDian @relation(fields: [idResolucionDian], references: [idResolucionDian], onDelete: Restrict, onUpdate: Cascade, map: "fk_facturas_electronicas_resoluciones_dian")

  prefijo     String @db.VarChar(10)
  consecutivo Int    @db.UnsignedInt

  fechaEmision DateTime @map("fecha_emision") @db.DateTime(0)

  cufe             String  @unique(map: "uq_facturas_electronicas_cufe") @db.VarChar(96)
  qrcodeData       String? @map("qrcode_data") @db.VarChar(500)
  xmlContent       String  @map("xml_content") @db.LongText
  nombreArchivoXml String  @map("nombre_archivo_xml") @db.VarChar(255)

  estadoDian   EstadoDocumentoDian @default(PENDIENTE) @map("estado_dian")
  trackId      String?             @map("track_id") @db.VarChar(100)
  mensajeError String?             @map("mensaje_error") @db.Text

  subtotal   Decimal @db.Decimal(20, 2)
  iva        Decimal @default(0.00) @db.Decimal(20, 2)
  incConsumo Decimal @default(0.00) @map("inc_consumo") @db.Decimal(20, 2)
  ica        Decimal @default(0.00) @db.Decimal(20, 2)
  total      Decimal @db.Decimal(20, 2)

  items FacturaElectronicaItem[]

  fechaCreacion      DateTime @default(now()) @map("fecha_creacion") @db.DateTime(0)
  fechaActualizacion DateTime @default(now()) @updatedAt @map("fecha_actualizacion") @db.DateTime(0)

  notasCredito NotaCredito[]
  notasDebito  NotaDebito[]

  @@unique([prefijo, consecutivo], map: "uq_facturas_electronicas_prefijo_consecutivo")
  @@index([estadoDian, fechaCreacion], map: "idx_facturas_electronicas_estado_fecha")
  @@index([idRazonSocial], map: "idx_facturas_electronicas_razon_social")
  @@index([idClienteDian], map: "idx_facturas_electronicas_cliente")
  @@map("facturas_electronicas")
}

model FacturaElectronicaItem {
  idFacturaElectronicaItem Int @id @default(autoincrement()) @map("id_factura_electronica_item") @db.UnsignedInt

  idFacturaElectronica Int                @map("id_factura_electronica") @db.UnsignedInt
  facturaElectronica   FacturaElectronica @relation(fields: [idFacturaElectronica], references: [idFacturaElectronica], onDelete: Cascade, onUpdate: Cascade, map: "fk_factura_electronica_items_facturas")

  descripcion    String  @db.VarChar(255)
  cantidad       Decimal @db.Decimal(15, 3)
  precioUnitario Decimal @map("precio_unitario") @db.Decimal(20, 2)
  descuento      Decimal @default(0.00) @db.Decimal(20, 2)
  subtotal       Decimal @db.Decimal(20, 2)

  codigoImpuesto1 String  @default("01") @map("codigo_impuesto_1") @db.VarChar(5)
  valorImpuesto1  Decimal @default(0.00) @map("valor_impuesto_1") @db.Decimal(20, 2)
  codigoImpuesto2 String? @map("codigo_impuesto_2") @db.VarChar(5)
  valorImpuesto2  Decimal @default(0.00) @map("valor_impuesto_2") @db.Decimal(20, 2)
  codigoImpuesto3 String? @map("codigo_impuesto_3") @db.VarChar(5)
  valorImpuesto3  Decimal @default(0.00) @map("valor_impuesto_3") @db.Decimal(20, 2)

  total Decimal @db.Decimal(20, 2)

  @@index([idFacturaElectronica], map: "idx_factura_electronica_items_factura")
  @@map("factura_electronica_items")
}

model DocumentoSoporte {
  idDocumentoSoporte Int @id @default(autoincrement()) @map("id_documento_soporte") @db.UnsignedInt

  idRazonSocial Int         @map("id_razon_social") @db.UnsignedInt
  razonSocial   RazonSocial @relation(fields: [idRazonSocial], references: [idRazonSocial], onDelete: Restrict, onUpdate: Cascade, map: "fk_documentos_soporte_razones_sociales")

  prefijo     String @db.VarChar(10)
  consecutivo Int    @db.UnsignedInt

  fechaEmision DateTime @map("fecha_emision") @db.DateTime(0)

  cuds             String  @unique(map: "uq_documentos_soporte_cuds") @db.VarChar(96)
  xmlContent       String? @map("xml_content") @db.LongText
  nombreArchivoXml String? @map("nombre_archivo_xml") @db.VarChar(255)

  estadoDian   EstadoDocumentoDian @default(PENDIENTE) @map("estado_dian")
  trackId      String?             @map("track_id") @db.VarChar(100)
  mensajeError String?             @map("mensaje_error") @db.Text

  fechaCreacion      DateTime @default(now()) @map("fecha_creacion") @db.DateTime(0)
  fechaActualizacion DateTime @default(now()) @updatedAt @map("fecha_actualizacion") @db.DateTime(0)

  @@unique([prefijo, consecutivo], map: "uq_documentos_soporte_prefijo_consecutivo")
  @@index([idRazonSocial], map: "idx_documentos_soporte_razon_social")
  @@map("documentos_soporte")
}

model NotaCredito {
  idNotaCredito Int @id @default(autoincrement()) @map("id_nota_credito") @db.UnsignedInt

  idFacturaElectronica Int                @map("id_factura_electronica") @db.UnsignedInt
  facturaElectronica   FacturaElectronica @relation(fields: [idFacturaElectronica], references: [idFacturaElectronica], onDelete: Restrict, onUpdate: Cascade, map: "fk_notas_credito_facturas_electronicas")

  prefijo     String @db.VarChar(10)
  consecutivo Int    @db.UnsignedInt

  fechaEmision DateTime @map("fecha_emision") @db.DateTime(0)

  cude               String  @unique(map: "uq_notas_credito_cude") @db.VarChar(96)
  conceptoCorreccion String  @default("2") @map("concepto_correccion") @db.VarChar(5)
  descripcionMotivo  String? @map("descripcion_motivo") @db.VarChar(255)

  xmlContent       String? @map("xml_content") @db.LongText
  nombreArchivoXml String? @map("nombre_archivo_xml") @db.VarChar(255)

  estadoDian   EstadoDocumentoDian @default(PENDIENTE) @map("estado_dian")
  trackId      String?             @map("track_id") @db.VarChar(100)
  mensajeError String?             @map("mensaje_error") @db.Text

  fechaCreacion      DateTime @default(now()) @map("fecha_creacion") @db.DateTime(0)
  fechaActualizacion DateTime @default(now()) @updatedAt @map("fecha_actualizacion") @db.DateTime(0)

  @@unique([prefijo, consecutivo], map: "uq_notas_credito_prefijo_consecutivo")
  @@index([idFacturaElectronica], map: "idx_notas_credito_factura")
  @@map("notas_credito")
}

model NotaDebito {
  idNotaDebito Int @id @default(autoincrement()) @map("id_nota_debito") @db.UnsignedInt

  idFacturaElectronica Int                @map("id_factura_electronica") @db.UnsignedInt
  facturaElectronica   FacturaElectronica @relation(fields: [idFacturaElectronica], references: [idFacturaElectronica], onDelete: Restrict, onUpdate: Cascade, map: "fk_notas_debito_facturas_electronicas")

  prefijo     String @db.VarChar(10)
  consecutivo Int    @db.UnsignedInt

  fechaEmision DateTime @map("fecha_emision") @db.DateTime(0)

  cude               String  @unique(map: "uq_notas_debito_cude") @db.VarChar(96)
  conceptoCorreccion String  @default("3") @map("concepto_correccion") @db.VarChar(5)
  descripcionMotivo  String? @map("descripcion_motivo") @db.VarChar(255)

  xmlContent       String? @map("xml_content") @db.LongText
  nombreArchivoXml String? @map("nombre_archivo_xml") @db.VarChar(255)

  estadoDian   EstadoDocumentoDian @default(PENDIENTE) @map("estado_dian")
  trackId      String?             @map("track_id") @db.VarChar(100)
  mensajeError String?             @map("mensaje_error") @db.Text

  fechaCreacion      DateTime @default(now()) @map("fecha_creacion") @db.DateTime(0)
  fechaActualizacion DateTime @default(now()) @updatedAt @map("fecha_actualizacion") @db.DateTime(0)

  @@unique([prefijo, consecutivo], map: "uq_notas_debito_prefijo_consecutivo")
  @@index([idFacturaElectronica], map: "idx_notas_debito_factura")
  @@map("notas_debito")
}

model EventoDian {
  idEventoDian Int @id @default(autoincrement()) @map("id_evento_dian") @db.UnsignedInt

  documentId   Int            @map("document_id") @db.UnsignedInt
  documentType String         @map("document_type") @db.VarChar(30) // 'FACTURA_ELECTRONICA' | 'DOCUMENTO_SOPORTE' | 'NOTA_CREDITO' | 'NOTA_DEBITO'
  eventType    TipoEventoDian @map("event_type")

  timestamp    DateTime @default(now()) @db.DateTime(0)
  actor        String?  @db.VarChar(150)
  metadataJson String?  @map("metadata_json") @db.Text

  @@index([documentType, documentId], map: "idx_eventos_dian_document")
  @@map("dian_document_events")
}

// ======================================================
// RECEPCIÓN DIAN — INGESTA MANUAL (FASE 1)
// Documentos (factura/NC/ND) recibidos de proveedores, cargados por XML
// suelto o por el Excel de "Documentos Recibidos" del portal DIAN.
// Conector/extensión Chrome, IMAP y motor de aprendizaje PUC quedan
// fuera de alcance de esta fase (ver plan de migración).
// ======================================================

enum TipoDocumentoRecibido {
  FACTURA
  NOTA_CREDITO
  NOTA_DEBITO
}

enum OrigenDocumentoRecibido {
  MANUAL
  EXCEL_PORTAL
}

enum EstadoCausacionRecibido {
  PENDIENTE
  CONCILIADO
  CAUSADO
  EXPORTADO
  RECHAZADO
  ERROR_XML
}

enum NaturalezaContable {
  D
  C
}

enum EstadoMapeoPuc {
  SIN_MAPEAR
  MAPEADO
}

model DocumentoRecibido {
  idDocumentoRecibido Int @id @default(autoincrement()) @map("id_documento_recibido") @db.UnsignedInt

  idRazonSocial Int  @map("id_razon_social") @db.UnsignedInt
  idCasino      Int? @map("id_casino") @db.UnsignedInt

  razonSocial RazonSocial @relation(fields: [idRazonSocial], references: [idRazonSocial], onDelete: Restrict, onUpdate: Cascade, map: "fk_documentos_recibidos_razones_sociales")
  casino      Casino?     @relation(fields: [idCasino], references: [idCasino], onDelete: SetNull, onUpdate: Cascade, map: "fk_documentos_recibidos_casinos")

  cufe                    String?               @unique(map: "uq_documentos_recibidos_cufe") @db.VarChar(96)
  tipoDocumento           TipoDocumentoRecibido @map("tipo_documento")
  prefijo                 String?               @db.VarChar(10)
  consecutivo             String?               @db.VarChar(30)
  numeroDocumentoCompleto String                @map("numero_documento_completo") @db.VarChar(60)

  nitEmisor    String @map("nit_emisor") @db.VarChar(30)
  nombreEmisor String @map("nombre_emisor") @db.VarChar(180)

  fechaEmision DateTime @map("fecha_emision") @db.DateTime(0)

  subtotal        Decimal @default(0.00) @db.Decimal(20, 2)
  iva             Decimal @default(0.00) @db.Decimal(20, 2)
  ica             Decimal @default(0.00) @db.Decimal(20, 2)
  retencionFuente Decimal @default(0.00) @map("retencion_fuente") @db.Decimal(20, 2)
  reteIva         Decimal @default(0.00) @map("rete_iva") @db.Decimal(20, 2)
  reteIca         Decimal @default(0.00) @map("rete_ica") @db.Decimal(20, 2)
  totalPagar      Decimal @default(0.00) @map("total_pagar") @db.Decimal(20, 2)

  xmlOriginal String? @map("xml_original") @db.LongText
  qrUrl       String? @map("qr_url") @db.VarChar(500)

  origen                       OrigenDocumentoRecibido @default(MANUAL)
  estadoCausacion              EstadoCausacionRecibido @default(PENDIENTE) @map("estado_causacion")
  pucPreliminar                String?                 @map("puc_preliminar") @db.VarChar(50)
  requiereRevisionConciliacion Boolean                 @default(false) @map("requiere_revision_conciliacion")

  items ItemCompraRecibido[]

  fechaCreacion      DateTime @default(now()) @map("fecha_creacion") @db.DateTime(0)
  fechaActualizacion DateTime @default(now()) @updatedAt @map("fecha_actualizacion") @db.DateTime(0)

  @@index([idRazonSocial], map: "idx_documentos_recibidos_razon_social")
  @@index([idCasino], map: "idx_documentos_recibidos_casino")
  @@index([estadoCausacion, fechaCreacion], map: "idx_documentos_recibidos_estado_fecha")
  @@index([nitEmisor, numeroDocumentoCompleto, fechaEmision], map: "idx_documentos_recibidos_reconciliacion")
  @@map("documentos_recibidos")
}

model ItemCompraRecibido {
  idItemCompraRecibido Int @id @default(autoincrement()) @map("id_item_compra_recibido") @db.UnsignedInt

  idDocumentoRecibido Int               @map("id_documento_recibido") @db.UnsignedInt
  documentoRecibido   DocumentoRecibido @relation(fields: [idDocumentoRecibido], references: [idDocumentoRecibido], onDelete: Cascade, onUpdate: Cascade, map: "fk_items_compra_recibidos_documentos")

  idReglaAplicada Int?           @map("id_regla_aplicada") @db.UnsignedInt
  reglaAplicada   ReglaMapeoPUC? @relation(fields: [idReglaAplicada], references: [idReglaMapeoPuc], onDelete: SetNull, onUpdate: Cascade, map: "fk_items_compra_recibidos_reglas_puc")

  descripcion    String  @db.VarChar(255)
  cantidad       Decimal @db.Decimal(15, 3)
  precioUnitario Decimal @map("precio_unitario") @db.Decimal(20, 2)
  subtotal       Decimal @db.Decimal(20, 2)

  codigoImpuesto1 String  @default("01") @map("codigo_impuesto_1") @db.VarChar(5)
  valorImpuesto1  Decimal @default(0.00) @map("valor_impuesto_1") @db.Decimal(20, 2)
  codigoImpuesto2 String? @map("codigo_impuesto_2") @db.VarChar(5)
  valorImpuesto2  Decimal @default(0.00) @map("valor_impuesto_2") @db.Decimal(20, 2)
  codigoImpuesto3 String? @map("codigo_impuesto_3") @db.VarChar(5)
  valorImpuesto3  Decimal @default(0.00) @map("valor_impuesto_3") @db.Decimal(20, 2)

  total Decimal @db.Decimal(20, 2)

  cuentaPuc          String?             @map("cuenta_puc") @db.VarChar(50)
  nombreCuentaPuc    String?             @map("nombre_cuenta_puc") @db.VarChar(150)
  centroCostos       String?             @map("centro_costos") @db.VarChar(50)
  nombreCentroCostos String?             @map("nombre_centro_costos") @db.VarChar(150)
  naturaleza         NaturalezaContable?
  estadoMapeo        EstadoMapeoPuc      @default(SIN_MAPEAR) @map("estado_mapeo")

  @@index([idDocumentoRecibido], map: "idx_items_compra_recibidos_documento")
  @@index([idReglaAplicada], map: "idx_items_compra_recibidos_regla")
  @@map("items_compra_recibidos")
}

model ReglaMapeoPUC {
  idReglaMapeoPuc Int @id @default(autoincrement()) @map("id_regla_mapeo_puc") @db.UnsignedInt

  idRazonSocial Int         @map("id_razon_social") @db.UnsignedInt
  razonSocial   RazonSocial @relation(fields: [idRazonSocial], references: [idRazonSocial], onDelete: Restrict, onUpdate: Cascade, map: "fk_reglas_mapeo_puc_razones_sociales")

  nombre   String @db.VarChar(150)
  concepto String @db.VarChar(150)

  nitEmisor     String?                @map("nit_emisor") @db.VarChar(30)
  nombreEmisor  String?                @map("nombre_emisor") @db.VarChar(180)
  tipoDocumento TipoDocumentoRecibido? @map("tipo_documento")

  cuentaPuc       String             @map("cuenta_puc") @db.VarChar(50)
  nombreCuentaPuc String?            @map("nombre_cuenta_puc") @db.VarChar(150)
  centroCostos    String?            @map("centro_costos") @db.VarChar(50)
  naturaleza      NaturalezaContable

  prioridad Int     @default(0) @db.UnsignedInt
  activa    Boolean @default(true)

  itemsAplicados ItemCompraRecibido[]

  fechaCreacion      DateTime @default(now()) @map("fecha_creacion") @db.DateTime(0)
  fechaActualizacion DateTime @default(now()) @updatedAt @map("fecha_actualizacion") @db.DateTime(0)

  @@index([idRazonSocial, activa], map: "idx_reglas_mapeo_puc_razon_activa")
  @@index([nitEmisor], map: "idx_reglas_mapeo_puc_nit_emisor")
  @@map("reglas_mapeo_puc")
}
