generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

enum EstadoRegistro {
  ACTIVO
  INACTIVO
}

// ======================================================
// PAÍSES, DEPARTAMENTOS Y CIUDADES
// ======================================================

model Pais {
  idPais Int    @id @default(autoincrement()) @map("id_pais")
  nombre String @unique @db.VarChar(100)

  departamentos Departamento[]

  @@map("paises")
}

model Departamento {
  idDepartamento Int    @id @default(autoincrement()) @map("id_departamentos")
  nombre         String @db.VarChar(120)
  idPais         Int    @map("id_pais")

  pais     Pais     @relation(fields: [idPais], references: [idPais], onDelete: Restrict, onUpdate: Cascade)
  ciudades Ciudad[]

  @@unique([idPais, nombre])
  @@index([idPais])
  @@index([nombre])
  @@map("departamentos")
}

model Ciudad {
  idCiudad       Int            @id @default(autoincrement()) @map("id_ciudad")
  nombreCiudad   String         @map("nombre_ciudad") @db.VarChar(150)
  idDepartamento Int            @map("id_departamentos")
  estado         EstadoRegistro @default(ACTIVO)

  departamento Departamento @relation(fields: [idDepartamento], references: [idDepartamento], onDelete: Restrict, onUpdate: Cascade)
  usuarios     Usuario[]
  casinos      Casino[]

  fechaCreacion      DateTime @default(now()) @map("fecha_creacion")
  fechaActualizacion DateTime @default(now()) @updatedAt @map("fecha_actualizacion")

  @@unique([idDepartamento, nombreCiudad])
  @@index([idDepartamento])
  @@index([nombreCiudad])
  @@index([estado])
  @@map("ciudades")
}

// ======================================================
// USUARIOS
// ======================================================

model Usuario {
  id           Int    @id @default(autoincrement())
  nombre       String @db.VarChar(100)
  apellido     String @db.VarChar(100)
  cedula       String @unique @db.VarChar(30)
  correo       String @unique @db.VarChar(191)
  passwordHash String @map("password_hash") @db.VarChar(255)

  cargo           String   @db.VarChar(120)
  fechaNacimiento DateTime @map("fecha_nacimiento") @db.Date
  telefono        String   @db.VarChar(30)

  codigoHelisa String? @map("codigo_helisa") @db.VarChar(50)
  cuentaPuc    String? @map("cuenta_puc") @db.VarChar(50)
  imgUrl       String? @map("img_url") @db.VarChar(500)

  estado EstadoRegistro @default(ACTIVO)

  idTipoDoc Int @map("id_tipo_doc")
  idGenero  Int @map("id_genero")
  idRol     Int @map("id_rol")
  idCiudad  Int @map("id_ciudad")
  idCasino  Int @map("id_casino")

  tipoDocumento TipoDocumento @relation(fields: [idTipoDoc], references: [idTipoDoc], onDelete: Restrict, onUpdate: Cascade)
  genero        Genero        @relation(fields: [idGenero], references: [idGenero], onDelete: Restrict, onUpdate: Cascade)
  rol           Rol           @relation(fields: [idRol], references: [idRol], onDelete: Restrict, onUpdate: Cascade)
  ciudad        Ciudad        @relation(fields: [idCiudad], references: [idCiudad], onDelete: Restrict, onUpdate: Cascade)
  casino        Casino        @relation(fields: [idCasino], references: [idCasino], onDelete: Restrict, onUpdate: Cascade)

  fechaCreacion      DateTime @default(now()) @map("fecha_creacion")
  fechaActualizacion DateTime @default(now()) @updatedAt @map("fecha_actualizacion")

  @@index([estado])
  @@index([idTipoDoc])
  @@index([idGenero])
  @@index([idRol])
  @@index([idCiudad])
  @@index([idCasino])
  @@index([apellido, nombre])
  @@map("usuarios")
}

// ======================================================
// ROLES
// ======================================================

model Rol {
  idRol       Int            @id @default(autoincrement()) @map("id_rol")
  nombreRol   String         @unique @map("nombre_rol") @db.VarChar(100)
  descripcion String?        @db.VarChar(255)
  estado      EstadoRegistro @default(ACTIVO)

  usuarios Usuario[]

  fechaCreacion      DateTime @default(now()) @map("fecha_creacion")
  fechaActualizacion DateTime @default(now()) @updatedAt @map("fecha_actualizacion")

  @@index([estado])
  @@map("roles")
}

// ======================================================
// TIPOS DE DOCUMENTO
// ======================================================

model TipoDocumento {
  idTipoDoc Int            @id @default(autoincrement()) @map("id_tipo_doc")
  nombreDoc String         @unique @map("nombre_doc") @db.VarChar(50)
  estado    EstadoRegistro @default(ACTIVO)

  usuarios Usuario[]

  fechaCreacion      DateTime @default(now()) @map("fecha_creacion")
  fechaActualizacion DateTime @default(now()) @updatedAt @map("fecha_actualizacion")

  @@index([estado])
  @@map("tipos_documento")
}

// ======================================================
// GÉNEROS
// ======================================================

model Genero {
  idGenero     Int            @id @default(autoincrement()) @map("id_genero")
  nombreGenero String         @unique @map("nombre_genero") @db.VarChar(50)
  estado       EstadoRegistro @default(ACTIVO)

  usuarios Usuario[]

  fechaCreacion      DateTime @default(now()) @map("fecha_creacion")
  fechaActualizacion DateTime @default(now()) @updatedAt @map("fecha_actualizacion")

  @@index([estado])
  @@map("generos")
}

// ======================================================
// CENTROS DE COSTOS
// ======================================================

model CentroCosto {
  idCentroCosto     Int            @id @default(autoincrement()) @map("id_centro_costo")
  codigoCentroCosto String         @unique @map("codigo_centro_costo") @db.VarChar(50)
  nombreCentroCosto String         @map("nombre_centro_costo") @db.VarChar(150)
  estado            EstadoRegistro @default(ACTIVO)

  casinos Casino[]

  fechaCreacion      DateTime @default(now()) @map("fecha_creacion")
  fechaActualizacion DateTime @default(now()) @updatedAt @map("fecha_actualizacion")

  @@index([estado])
  @@index([nombreCentroCosto])
  @@map("centros_costos")
}

// ======================================================
// RAZONES SOCIALES
// ======================================================

model RazonSocial {
  idRazonSocial     Int            @id @default(autoincrement()) @map("id_razon_social")
  nit               String         @unique @db.VarChar(30)
  nombreRazonSocial String         @map("nombre_razon_social") @db.VarChar(180)
  estado            EstadoRegistro @default(ACTIVO)

  casinos Casino[]

  fechaCreacion      DateTime @default(now()) @map("fecha_creacion")
  fechaActualizacion DateTime @default(now()) @updatedAt @map("fecha_actualizacion")

  @@index([estado])
  @@index([nombreRazonSocial])
  @@map("razones_sociales")
}

// ======================================================
// CASINOS
// ======================================================

model Casino {
  idCasino Int @id @default(autoincrement()) @map("id_casino")

  nombreCasino          String @unique @map("nombre_casino") @db.VarChar(150)
  codigoDane            String @unique @map("codigo_dane") @db.VarChar(30)
  codigoEstablecimiento String @unique @map("codigo_establecimiento") @db.VarChar(50)

  telefono  String @db.VarChar(30)
  direccion String @db.VarChar(200)

  estado EstadoRegistro @default(ACTIVO)

  idCiudad      Int @map("id_ciudad")
  idCentroCosto Int @map("id_centro_costo")
  idRazonSocial Int @map("id_razon_social")

  ciudad      Ciudad      @relation(fields: [idCiudad], references: [idCiudad], onDelete: Restrict, onUpdate: Cascade)
  centroCosto CentroCosto @relation(fields: [idCentroCosto], references: [idCentroCosto], onDelete: Restrict, onUpdate: Cascade)
  razonSocial RazonSocial @relation(fields: [idRazonSocial], references: [idRazonSocial], onDelete: Restrict, onUpdate: Cascade)

  usuarios Usuario[]

  fechaCreacion      DateTime @default(now()) @map("fecha_creacion")
  fechaActualizacion DateTime @default(now()) @updatedAt @map("fecha_actualizacion")

  @@index([estado])
  @@index([idCiudad])
  @@index([idCentroCosto])
  @@index([idRazonSocial])
  @@index([nombreCasino])
  @@map("casinos")
}
